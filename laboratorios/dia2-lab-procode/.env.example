# Copia este archivo como .env y completa los valores que te entregan los instructores.
# NO hay llaves ni secretos: la autenticación usa Microsoft Entra ID (az login).
# Nunca subas tu .env a un repositorio.

# --- Proyecto de Microsoft Foundry y modelo de chat ---
# Portal de Foundry > tu proyecto > Overview > "Project endpoint"
FOUNDRY_PROJECT_ENDPOINT=https://<tu-recurso>.services.ai.azure.com/api/projects/<tu-proyecto>
# Nombre del DEPLOYMENT (no del modelo) que te indiquen los instructores
FOUNDRY_MODEL=<nombre-deployment-chat>

# --- Azure AI Search (índice creado por los instructores) ---
AZURE_SEARCH_ENDPOINT=https://<tu-servicio-search>.search.windows.net
AZURE_SEARCH_INDEX_NAME=normativa-austral

# --- Embeddings (solo si el índice tiene campo vectorial; búsqueda híbrida) ---
# Déjalo vacío si los instructores indican "índice solo texto".
FOUNDRY_EMBEDDING_MODEL=<nombre-deployment-embeddings>

# --- Nivel de acceso simulado del usuario: publico | interno | restringido ---
# Se usa para filtrar los documentos (security trimming). Por defecto: interno.
LAB_NIVEL_USUARIO=interno

# --- Observabilidad (Tarea 4) ---
# Opcional: si lo dejas vacío, el lab la obtiene del proyecto de Foundry (Application Insights conectado).
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Poner en true para ver también las trazas en la consola
ENABLE_CONSOLE_EXPORTERS=false

# Plan B: pon true solo si el servicio de Search NO tiene habilitado el ranker semántico
# LAB_SIN_SEMANTICO=false

# Plan B: pon true si el Application Insights del proyecto tiene la autenticación local deshabilitada
# (solo Microsoft Entra ID). Requiere el rol "Monitoring Metrics Publisher" sobre ese Application Insights.
# LAB_APPINSIGHTS_ENTRA=false
