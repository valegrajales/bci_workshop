# Copia a .env para correr localmente. En Foundry, FOUNDRY_PROJECT_ENDPOINT lo inyecta la plataforma
# y AZURE_AI_MODEL_DEPLOYMENT_NAME viene del bloque `env` de azure.yaml.
FOUNDRY_PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<proyecto>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
